@page "/"

<h1>Book List</h1>

<table class="table table-striped table-primary table-hover">
    <thead>
        <tr>
            <th scope="col">Title</th>
            <th scope="col">Page count</th>
            <th scope="col">Publish date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in _response.Books)
        {
            <tr style="cursor: pointer;">
                <th scope="row">@book.Title</th>
                <th scope="row">@book.PageCount</th>
                <th scope="row">@book.PublishDate.ToLongDateString()</th>
            </tr>
        }
    </tbody>
</table>

<RadzenPager HorizontalAlign="HorizontalAlign.Center" Count="_response.Count" PageSize="_response.Books.Count()" PageNumbersCount="5" PageChanged="PageChangedAsync" />