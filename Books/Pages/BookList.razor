@page "/"
@using Books.Routing

<div class="d-flex justify-content-between">
    <h1>Book List</h1>
    <button class="btn btn-primary mb-2" @onclick="_ => NavManager.NavigateTo(ClientRoutes.BookForm)">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-plus" viewBox="0 0 16 16">
            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
        </svg>
        Add New Book
    </button>
</div>

<table class="table table-striped table-primary table-hover">
    <thead>
        <tr>
            <th scope="col">Title</th>
            <th scope="col">Page count</th>
            <th scope="col">Publish date</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in _response.Books)
        {
            <tr style="cursor: pointer;" @onclick="_ => NavManager.NavigateTo(ClientRoutes.BookDetails(book.Id))">
                <th scope="row">@book.Title</th>
                <th scope="row">@book.PageCount</th>
                <th scope="row">@book.PublishDate.ToLongDateString()</th>
                <th scope="row">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16" @onclick="_ => NavManager.NavigateTo(ClientRoutes.EditBook(book.Id))" @onclick:stopPropagation="true">
                        <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" />
                        <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
                    </svg>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash-fill" viewBox="0 0 16 16" @onclick="_ => RemoveBookAsync(book.Id)" @onclick:stopPropagation="true">
                        <path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5M8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5m3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0" />
                    </svg>
                </th>
            </tr>
        }
    </tbody>
</table>

<RadzenPager HorizontalAlign="HorizontalAlign.Center" Count="_response.Count" PageSize="_response.Books.Count()" PageNumbersCount="5" PageChanged="PageChangedAsync" />